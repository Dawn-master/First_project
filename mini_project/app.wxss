/** 全局主题 */
page {
  --ink: #0F1C24;
  --paper: #F2F5F3;
  --panel: #FFFFFF;
  --teal: #1F7A6E;
  --amber: #D4A017;
  --coral: #D64545;
  --haze: #7A8B86;
  --line: #D5DDD8;
  --mono: "SF Mono", Consolas, "Courier New", monospace;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  font-size: 28rpx;
  min-height: 100%;
  height: auto;
}

.page {
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.pull-tip {
  text-align: center;
  color: var(--haze);
  font-size: 22rpx;
  padding: 8rpx 0 16rpx;
}

.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.muted {
  color: var(--haze);
  font-size: 24rpx;
}

.mono {
  font-family: var(--mono);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #EEF3F0;
  color: var(--teal);
  margin-right: 8rpx;
}

.tag.warn { background: #FFF4D6; color: #9A7400; }
.tag.danger { background: #FDECEC; color: #B33333; }
.tag.info { background: #E8F1F0; color: var(--teal); }

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: var(--haze);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--haze);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #F7FAF8;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 80rpx;
}

.form-textarea {
  min-height: 180rpx;
}

.submit-bar {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 20rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 30rpx;
}

.submit-bar.disabled {
  opacity: 0.5;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--haze);
  background: #fff;
}

.chip.on {
  border-color: var(--teal);
  color: var(--teal);
  background: #E8F1F0;
  font-weight: 600;
}
