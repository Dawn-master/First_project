<view class="auth-page">
  <view class="auth-hero">
    <view class="logo">注</view>
    <view class="title">注册账号</view>
    <view class="sub">注册后登录可查看监测数据</view>
  </view>

  <view class="card auth-card">
    <view class="form-item">
      <view class="form-label">用户名 *</view>
      <input class="form-input" placeholder="字母/数字/下划线，3-32 位"
        value="{{username}}" bindinput="onUsername" maxlength="32" />
    </view>
    <view class="form-item">
      <view class="form-label">昵称（选填）</view>
      <input class="form-input" placeholder="展示用"
        value="{{nickname}}" bindinput="onNickname" maxlength="16" />
    </view>
    <view class="form-item">
      <view class="form-label">密码 *</view>
      <input class="form-input" password placeholder="至少 6 位"
        value="{{password}}" bindinput="onPassword" maxlength="32" />
    </view>
    <view class="form-item">
      <view class="form-label">确认密码 *</view>
      <input class="form-input" password placeholder="再次输入密码"
        value="{{password2}}" bindinput="onPassword2" maxlength="32" />
    </view>

    <view class="submit-bar {{loading ? 'disabled' : ''}}" bindtap="onRegister">
      {{loading ? '提交中…' : '注 册'}}
    </view>

    <view class="auth-links">
      <text class="link" bindtap="goLogin">已有账号？返回登录</text>
    </view>
  </view>
</view>
