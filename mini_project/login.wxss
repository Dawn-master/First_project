.auth-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0F1C24 0%, #1A3038 42%, #F2F5F3 42%);
}

.auth-hero {
  color: #F2F5F3;
  text-align: center;
  margin-bottom: 48rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 28rpx;
  background: #1F7A6E;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 120rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9BB0AA;
}

.auth-card {
  padding: 36rpx 28rpx;
}

.auth-links {
  text-align: center;
  margin-top: 28rpx;
}

.link {
  color: var(--teal);
  font-size: 26rpx;
}

.auth-tip {
  margin-top: 24rpx;
  text-align: center;
}
