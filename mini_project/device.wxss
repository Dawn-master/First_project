.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EEF2EF;
  font-size: 28rpx;
}

.row:last-child { border-bottom: none; }
.k { color: var(--haze); }
.v { max-width: 60%; text-align: right; word-break: break-all; }

.fb {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEF2EF;
}

.fb:last-child { border-bottom: none; }
.fb-top { margin-bottom: 8rpx; }
.fb-content { font-size: 28rpx; line-height: 1.5; margin-bottom: 8rpx; }
