<view class="page">
  <view class="card">
    <view class="section-title" style="margin-top:0">当前账号</view>
    <view class="row"><text class="k">昵称</text><text class="v mono">{{nickname || '-'}}</text></view>
    <view class="row"><text class="k">用户名</text><text class="v mono">{{username || '-'}}</text></view>
    <view class="submit-bar" style="margin-top:24rpx" bindtap="onLogout">退出登录</view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">设备信息</view>
    <view class="row"><text class="k">设备 ID</text><text class="v mono">{{deviceId}}</text></view>
    <view class="row"><text class="k">后端地址</text><text class="v mono">{{apiBase}}</text></view>
    <view class="row"><text class="k">连接状态</text>
      <text class="v">{{backendOk ? '在线' : '离线'}}</text>
    </view>
    <view class="row"><text class="k">数据来源</text>
      <text class="v">仅硬件上报</text>
    </view>
    <view class="row"><text class="k">模拟数据</text>
      <text class="v">已禁用</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">问题反馈 / 报修</view>
    <view class="form-item">
      <view class="form-label">类型</view>
      <view class="chip-row" style="margin-bottom:0">
        <view
          wx:for="{{types}}"
          wx:key="key"
          class="chip {{type===item.key ? 'on' : ''}}"
          data-k="{{item.key}}"
          bindtap="onPickType"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="form-item">
      <view class="form-label">联系方式（选填）</view>
      <input class="form-input" placeholder="手机 / 微信 / 班级" value="{{contact}}" bindinput="onContact" />
    </view>
    <view class="form-item">
      <view class="form-label">问题描述</view>
      <textarea
        class="form-textarea"
        placeholder="例如：MQ135 一直为 0，请安排检查传感器接线"
        maxlength="500"
        value="{{content}}"
        bindinput="onContent"
      ></textarea>
    </view>
    <view class="submit-bar {{submitting ? 'disabled' : ''}}" bindtap="onSubmitFeedback">
      {{submitting ? '提交中…' : '提交报修反馈'}}
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">我的反馈</view>
    <view class="empty" wx:if="{{!loadingList && !items.length}}">暂无反馈记录</view>
    <view class="fb" wx:for="{{items}}" wx:key="id">
      <view class="fb-top">
        <text class="tag">{{item.typeLabel}}</text>
        <text class="tag {{item.statusClass}}">{{item.status}}</text>
      </view>
      <view class="fb-content">{{item.content}}</view>
      <view class="muted mono">{{item.time}} · 联系：{{item.contact}}</view>
    </view>
  </view>

  <view class="pull-tip">下拉页面可刷新设备状态与反馈</view>
</view>
